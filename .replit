modules = ["python-3.12", "nodejs-20", "web", "bash"]

[nix]
channel = "stable-25_05"
packages = ["uv", "gcc"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Alpha Harness"

[[workflows.workflow]]
name = "Alpha Harness"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = """
set -e
export LD_LIBRARY_PATH=/nix/store/d6xaahvgpwbs75jqh586a2ji49macph4-xgcc-14.2.1.20250322-lib/lib:${LD_LIBRARY_PATH:-}
(cd backend && uv run uvicorn alpha_harness.main:app --host 0.0.0.0 --port 8000) &
BACKEND_PID=$!
trap 'kill \"$BACKEND_PID\" 2>/dev/null || true' EXIT
for attempt in $(seq 1 60); do
  if curl -fsS http://127.0.0.1:8000/api/health >/dev/null; then
    break
  fi
  if ! kill -0 \"$BACKEND_PID\" 2>/dev/null; then
    wait \"$BACKEND_PID\"
    exit 1
  fi
  if [ \"$attempt\" -eq 60 ]; then
    echo \"Backend did not become healthy within 60 seconds\" >&2
    exit 1
  fi
  sleep 1
done
cd frontend
pnpm install --frozen-lockfile
pnpm dev --host 0.0.0.0 --port 5000"""
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8000
externalPort = 8000
